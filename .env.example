# Sai 1.0 — минимальный .env для self-host.
# Скопируйте в .env и заполните обязательные поля.

## ---------- App ----------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PORT=3000

## ---------- Database (PostgreSQL + pgvector) ----------
# docker compose (self-host) публикует 5432; docker-compose.dev.yml — 5434.
DATABASE_URL=postgresql://sai:sai@localhost:5432/sai?schema=public&connection_limit=20
DIRECT_URL=postgresql://sai:sai@localhost:5432/sai?schema=public

## ---------- Auth (локальный пользователь) ----------
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

## ---------- BYOK encryption ----------
# Серверная половина master-ключа. Никогда не коммитьте.
# Generate: openssl rand -base64 32
BYOK_SERVER_SECRET=replace-me-32-bytes-base64

## ---------- Defaults ----------
DEFAULT_LOCALE=ru
TZ=UTC
