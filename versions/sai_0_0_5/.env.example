# Sai 1.0 — минимальный .env для self-host.
# Скопируйте в .env и заполните обязательные поля.

## ---------- Sai Mode ----------
# cloud — SaaS, биллинг Stripe включён, жёсткие лимиты Free плана
# selfhost — без биллинга, без лимитов узлов / проектов
SAI_MODE=selfhost
NODE_ENV=development

## ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PORT=3000

## ---------- Database (PostgreSQL + pgvector) ----------
DATABASE_URL=postgresql://sai:sai@localhost:5432/sai?schema=public&connection_limit=20
DIRECT_URL=postgresql://sai:sai@localhost:5432/sai?schema=public

## ---------- Auth.js v5 ----------
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

## OAuth (опционально — пустые значения отключают провайдер)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

## ---------- BYOK encryption ----------
# Серверная половина master-ключа. Никогда не коммитьте.
# Generate: openssl rand -base64 32
BYOK_SERVER_SECRET=replace-me-32-bytes-base64

## ---------- Defaults ----------
DEFAULT_LOCALE=ru
TZ=UTC

## ========== Опционально (для будущих версий) ==========

## ---------- Redis (v1.1+) ----------
# REDIS_URL=redis://localhost:6379

## ---------- S3 / MinIO (v1.1+) ----------
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=sai-dev
# S3_SECRET_KEY=sai-dev-secret
# S3_BUCKET=sai-attachments

## ---------- Email (v1.1+) ----------
# EMAIL_FROM="Sai <no-reply@sai.local>"
# RESEND_API_KEY=

## ---------- Stripe (Cloud only) ----------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

## ---------- AI / PostHog (опционально) ----------
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
