/* Sai — Catppuccin Mocha QSS Theme */

QMainWindow {
    background-color: #1e1e2e;
}

QGraphicsView {
    border: none;
    background: transparent;
}

QDockWidget {
    border: none;
    titlebar-close-icon: none;
}

QDockWidget::title {
    background-color: #181825;
    padding: 6px 10px;
    font-size: 11px;
    color: #cdd6f4;
    border-bottom: 1px solid #313244;
}

QDockWidget::close-button {
    border: none;
    padding: 2px;
}

QDockWidget::close-button:hover {
    background: #45475a;
    border-radius: 3px;
}

QSplitter::handle {
    background: #313244;
    width: 1px;
}

/* Scrollbar styling */
QScrollBar:vertical {
    width: 6px;
    background: transparent;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #585b70;
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #6c7086;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    height: 6px;
    background: transparent;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #585b70;
    border-radius: 3px;
    min-width: 20px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* Tooltip */
QToolTip {
    background: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
}

/* Selection */
QGraphicsView::selected {
    background: transparent;
}
