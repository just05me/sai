// Sai Web — единая схема PostgreSQL
// Включает pgvector для semantic search и Team AI Memory (RAG)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector"), pgcrypto, citext]
}

/// ---------- AUTH (Auth.js v5) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  bio           String?
  timezone      String    @default("UTC")
  locale        String    @default("ru")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  workspaces      WorkspaceMember[]
  ownedWorkspaces Workspace[]       @relation("OwnerWorkspaces")
  twoFactor       TwoFactor?
  apiTokens       ApiToken[]
  notifications   Notification[]
  comments        Comment[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String?
  ipAddress    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model TwoFactor {
  userId    String   @id
  secret    String
  enabled   Boolean  @default(false)
  recovery  String[] @default([])
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Анонимная сессия Quick Capture (TTL 24 ч).
model AnonSession {
  id        String   @id @default(cuid())
  token     String   @unique
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// ---------- WORKSPACES ----------

enum WorkspaceKind {
  PERSONAL
  TEAM
}

enum Plan {
  FREE
  PRO
  TEAM
  SELFHOST_PRO
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  COMMENTER
  VIEWER
}

model Workspace {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  kind      WorkspaceKind @default(PERSONAL)
  avatarUrl String?
  ownerId   String
  plan      Plan          @default(FREE)
  settings  Json          @default("{}")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  owner    User                @relation("OwnerWorkspaces", fields: [ownerId], references: [id])
  members  WorkspaceMember[]
  projects Project[]
  keys     ByokKey[]
  tokens   ApiToken[]
  billing  Billing?
  memories AiMemory[]
  webhooks WebhookEndpoint[]
  invites  WorkspaceInvite[]
  audits   AuditLog[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(EDITOR)
  joinedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model WorkspaceInvite {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  role        Role     @default(EDITOR)
  token       String   @unique
  invitedBy   String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
}

/// ---------- BYOK ----------

enum AiProvider {
  OPENAI
  ANTHROPIC
  OPENROUTER
  OLLAMA
  CUSTOM
  DEEPSEEK
}

model ByokKey {
  id              String     @id @default(cuid())
  workspaceId     String
  provider        AiProvider
  label           String
  encryptedKey    Bytes
  iv              Bytes
  salt            Bytes
  baseUrl         String?
  defaultModel    String?
  isDefault       Boolean    @default(false)
  lastUsedAt      DateTime?
  monthlyTokens   BigInt     @default(0)
  monthlyCostCent Int        @default(0)
  createdAt       DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, label])
  @@index([workspaceId])
}

/// ---------- API TOKENS (Public API) ----------

enum ApiScope {
  READ
  WRITE
  ADMIN
}

model ApiToken {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  prefix      String     @unique
  hashedKey   String
  scopes      ApiScope[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
  revokedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// ---------- BILLING ----------

model Billing {
  id                   String   @id @default(cuid())
  workspaceId          String   @unique
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  status               String?
  updatedAt            DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// ---------- PROJECTS / TREES / NODES ----------

enum TreeKind {
  DEV
  FUNC
  BIZ
}

enum NodeStatus {
  IDEA
  IN_PROGRESS
  DONE
  BLOCKED
}

enum HypothesisStatus {
  NONE
  UNTESTED
  TESTING
  VALIDATED
  INVALIDATED
}

enum EdgeKind {
  PARENT_CHILD
  DEPENDS_ON
  RELATES_TO
  BRIDGE
}

enum OriginKind {
  MANUAL
  AI_GENERATE
  AI_EXPAND
  AI_DEEPEN
  TEMPLATE
  IMPORT
}

model Project {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  emoji       String?
  archivedAt  DateTime?
  pinnedAt    DateTime?
  publicSlug  String?  @unique
  createdById String?
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  trees       Tree[]
  nodes       Node[]
  edges       Edge[]
  chats       Chat[]
  snapshots   Snapshot[]
  shares      ShareLink[]
  yjsDocument YjsDocument?
  comments    Comment[]
  hypotheses  Hypothesis[]
  stickyNotes StickyNote[]
  ideaScores  IdeaScore[]

  @@index([workspaceId])
}

model Tree {
  id        String   @id @default(cuid())
  projectId String
  kind      TreeKind
  rootId    String?  @unique
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodes   Node[]

  @@unique([projectId, kind])
}

model Node {
  id               String           @id @default(cuid())
  projectId        String
  treeId           String
  parentId         String?
  title            String
  description      String?          @db.Text
  tags             String[]         @default([])
  status           NodeStatus       @default(IDEA)
  assigneeId       String?
  hypothesisStatus HypothesisStatus @default(NONE)
  healthScore      Int              @default(0)
  origin           Json             @default("{}")
  decisionLog      Json             @default("[]")
  position         Json             @default("{\"x\":0,\"y\":0}")
  collapsed        Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tree     Tree    @relation(fields: [treeId], references: [id], onDelete: Cascade)
  parent   Node?   @relation("NodeChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children Node[]  @relation("NodeChildren")

  comments   Comment[]
  hypothesis Hypothesis?
  history    NodeHistory[]

  @@index([projectId, treeId])
  @@index([parentId])
}

model NodeHistory {
  id        String   @id @default(cuid())
  nodeId    String
  source    String
  diff      Json
  authorId  String?
  createdAt DateTime @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, createdAt])
}

model Edge {
  id        String   @id @default(cuid())
  projectId String
  sourceId  String
  targetId  String
  kind      EdgeKind @default(PARENT_CHILD)
  label     String?
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, kind])
  @@index([projectId])
}

model StickyNote {
  id        String   @id @default(cuid())
  projectId String
  treeKind  TreeKind
  body      String   @db.Text
  color     String   @default("#FEF3C7")
  position  Json     @default("{\"x\":0,\"y\":0}")
  pinnedNodeId String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Hypothesis {
  id         String           @id @default(cuid())
  projectId  String
  nodeId     String           @unique
  status     HypothesisStatus @default(UNTESTED)
  question   String
  learnings  String?          @db.Text
  updatedAt  DateTime         @updatedAt
  createdAt  DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  node    Node    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

model IdeaScore {
  id              String   @id @default(cuid())
  projectId       String
  feasibility     Int
  marketPotential Int
  completeness    Int
  blindSpots      Json
  details         Json
  createdAt       DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// ---------- CHATS ----------

enum ChatKind {
  GLOBAL
  NODE
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

model Chat {
  id        String   @id @default(cuid())
  projectId String
  kind     ChatKind
  nodeId    String?
  persona   String?
  provider  AiProvider?
  model     String?
  createdAt DateTime @default(now())

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([projectId, kind])
}

model ChatMessage {
  id          String   @id @default(cuid())
  chatId      String
  role        ChatRole
  content     String   @db.Text
  toolCalls   Json?
  attachments Json     @default("[]")
  tokenInput  Int      @default(0)
  tokenOutput Int      @default(0)
  costCent    Int      @default(0)
  createdAt   DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

/// ---------- SNAPSHOTS / TIME TRAVEL ----------

model Snapshot {
  id        String   @id @default(cuid())
  projectId String
  label     String?
  reason    String?
  yjsState  Bytes
  hash      String
  size      Int
  authorId  String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// ---------- YJS PERSISTENCE ----------

model YjsDocument {
  projectId String   @id
  data      Bytes
  version   Int      @default(0)
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// ---------- COLLABORATION ----------

model Comment {
  id         String   @id @default(cuid())
  projectId  String
  nodeId     String?
  edgeId     String?
  parentId   String?
  authorId   String
  body       String   @db.Text
  resolvedAt DateTime?
  createdAt  DateTime @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  node     Node?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  children Comment[] @relation("CommentThread")

  @@index([projectId])
  @@index([nodeId])
}

/// ---------- SHARING ----------

enum SharePermission {
  VIEW
  COMMENT
  EDIT
}

model ShareLink {
  id           String          @id @default(cuid())
  projectId    String
  token        String          @unique
  permission   SharePermission @default(VIEW)
  passwordHash String?
  expiresAt    DateTime?
  createdById  String?
  createdAt    DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// ---------- TEMPLATES ----------

enum TemplateScope {
  PERSONAL
  WORKSPACE
  PUBLIC
}

model Template {
  id            String        @id @default(cuid())
  authorId      String?
  workspaceId   String?
  scope         TemplateScope @default(PERSONAL)
  name          String
  description   String?
  category      String?
  payload       Json
  thumbnail     String?
  forkCount     Int           @default(0)
  rating        Float         @default(0)
  createdAt     DateTime      @default(now())

  @@index([scope, category])
}

/// ---------- NOTIFICATIONS ----------

enum NotificationKind {
  MENTION
  COMMENT
  STATUS_CHANGE
  INVITE
  AI_DONE
  SHARE_OPENED
  BILLING
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  kind       NotificationKind
  payload    Json
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/// ---------- WEBHOOKS (Public API) ----------

model WebhookEndpoint {
  id          String   @id @default(cuid())
  workspaceId String
  url         String
  events      String[]
  secret      String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  endpointId  String
  event       String
  payload     Json
  status      Int?
  responseBody String? @db.Text
  attempt     Int      @default(0)
  deliveredAt DateTime?
  createdAt   DateTime @default(now())

  @@index([endpointId, createdAt])
}

/// ---------- AI MEMORY (RAG / Team) ----------

model AiMemory {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  source      String
  content     String   @db.Text
  embedding   Unsupported("vector(1536)")?
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// ---------- AUDIT ----------

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  entity      String
  entityId    String?
  ip          String?
  userAgent   String?
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}
